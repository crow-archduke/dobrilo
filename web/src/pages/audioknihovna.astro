---
// S09 Audioknihovna — spec §6 (S09). Real catalog (22 finished audiobooks already exist in
// "hotové audioknihy/", satisfying the Readiness Rule for L07) but no player/chapters yet — S10
// detail pages, real audio hosting and covers are PHASE B work. This page is honest about that
// split: real titles, no fake "Poslechnout" buttons.
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';

const place = await getEntry('places', 'audioknihovna');

const groups = [
  {
    label: '1. stupeň · česky',
    titles: [
      'Broučci', 'Bylo nás pět', 'Devatero pohádek', 'Dášeňka čili život štěněte',
      'Edudant a Francimor', 'K. J. Erben – Pohádky', 'Klapzubova jedenáctka',
      'Kubula a Kuba Kubikula', 'Povídání o pejskovi a kočičce', 'Staré pověsti české',
    ],
  },
  {
    label: '1. stupeň · anglicky',
    titles: [
      "Alice's Adventures in Wonderland", 'Peter Pan', 'The Tale of Peter Rabbit',
      'Winnie the Pooh', "Æsop's Fables",
    ],
  },
  {
    label: '2. stupeň',
    titles: [
      'Babička', 'Božena Němcová – Nejznámější pohádky', 'Liška Bystrouška', 'Krysař',
      'Povídky malostranské', 'Rozmarné léto', 'Utrpení knížete Sternenhocha',
    ],
  },
];
---
<Base title={place.data.name} description={place.data.description}>
  <p class="breadcrumb section" style="padding-bottom:0">
    <a href="/">Mapa ostrova</a> · <a href="/mestecko-dobrilo">Městečko Dobrilo</a>
  </p>
  <div class="page-hero">
    <p class="page-hero__eyebrow">{place.data.subtitle}</p>
    <h1>{place.data.name}</h1>
    <p class="page-hero__desc">{place.data.description}</p>
  </div>

  {groups.map((g) => (
    <section class="section">
      <h2>{g.label}</h2>
      <ul class="place-page__list">
        {g.titles.map((t) => <li>{t}</li>)}
      </ul>
    </section>
  ))}

  <a class="back-link" href="/mestecko-dobrilo">← Městečko Dobrilo</a>
</Base>
